{
  "name": "winception",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "web": "node tools/osdcloud-console/src/webServer.js",
    "server:preflight": "node tools/osdcloud-console/src/serverPreflight.js",
    "check": "node tools/osdcloud-console/src/check.js",
    "test": "node --test \"tools/osdcloud-console/test/**/*.test.js\"",
    "smoke": "node tools/osdcloud-console/src/smoke.js",
    "reload": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/Reload-Console.ps1",
    "acceptance:source": "node tools/acceptance/source.mjs",
    "acceptance:ui": "playwright test --config tools/acceptance/playwright.config.js"
  },
  "dependencies": {
    "bencode": "^4.0.1",
    "bittorrent-protocol": "^5.0.6",
    "create-torrent": "^6.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
